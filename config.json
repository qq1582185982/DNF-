{
  "network": {
    "tunnel_port": 30003,                        # 必填：公网隧道入口端口
    "virtual_subnet": "10.0.11.0/24",           # 必填：虚拟局域网网段
    "virtual_gateway": "10.0.11.1",             # 必填：虚拟网关 IP
    "tunnel_server_ip": "vpn.example.com",      # 必填：公网入口域名或 IP
    "max_connections": 100,                     # 可选：最大并发连接数
    "lease_seconds": 120                        # 可选：IP 租约时长，单位秒
  },

  "nodes": [
    {
      "name": "节点1",                           # 绑定在网关机本地的服务节点
      "server_virtual_ip": "10.0.11.2",
      "bind_on_gateway": true,
      "download_url": ""
    },
    {
      "name": "节点2",                           # 远端 Linux 节点示例
      "server_virtual_ip": "10.0.11.5",
      "bind_on_gateway": false,
      "download_url": ""
    }
  ],

  "version": {
    "md5": "00000000000000000000000000000000",  # 可选：客户端版本 MD5
    "download_url": "https://example.com/client.zip"
  },

  "log_level": "INFO",

  "api_config": {
    "enabled": true,
    "port": 35000                               # 配置接口端口
  }
}
